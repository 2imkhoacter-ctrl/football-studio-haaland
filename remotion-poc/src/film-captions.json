[{"t0":0.4,"t1":1.4,"who":"","text":"LUYỆN SÚT ⚽"},{"t0":1.6,"t1":4.6,"who":"HAALAND","text":"Chào cả nhà! Mình là Haaland!"},{"t0":5.3,"t1":8.8,"who":"HAALAND","text":"Hôm nay mình tập sút với người nộm này."},{"t0":9.6,"t1":11.8,"who":"HAALAND","text":"Ơ… ai đây nhỉ?"},{"t0":12.6,"t1":15.2,"who":"VINI","text":"Vini đây! Cho tôi sút thử với!"},{"t0":15.5,"t1":19.3,"who":"HAALAND","text":"Được thôi, sút trượt thì khao kem nhé!"},{"t0":19.8,"t1":22.5,"who":"VINI","text":"Dễ ợt! Xem ai trượt cho biết!"},{"t0":22.8,"t1":25.5,"who":"HAALAND","text":"Xem đây…"},{"t0":29.4,"t1":32.2,"who":"VINI","text":"Ơ! Người nộm quay như chong chóng!"},{"t0":32.8,"t1":36,"who":"VINI","text":"Hên thôi! Đến lượt tôi!"},{"t0":36.4,"t1":39,"who":"HAALAND","text":"Haha, nhảy đi nào!"},{"t0":39.4,"t1":45.8,"who":"VINI","text":"Điệu samba này đây!"},{"t0":46.8,"t1":50.2,"who":"HAALAND","text":"Giỏi lắm! Chụp ảnh chung nào!"},{"t0":50.8,"t1":56,"who":"HAALAND","text":"Theo dõi để xem phần 2 nhé!"}]